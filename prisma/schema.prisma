generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  user
  admin
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(user)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  sponsorships  Sponsorship[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum AnimalSex {
  MALE
  FEMALE
}

enum AnimalStatus {
  ACTIVE
  INACTIVE
}

enum SponsorshipType {
  ANIMAL
  GENERAL
}

enum SponsorshipFrequency {
  SINGLE
  RECURRING
}

enum SponsorshipStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Species {
  id               String   @id @default(cuid())
  scientificName   String   @unique
  commonName       String
  description      String
  morphology       String
  habitat          String
  diet             String
  imageUrl         String
  catalogLinkLabel String?
  isVisible        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  animals Animal[]

  @@index([commonName])
}

model Animal {
  id                        String       @id @default(cuid())
  name                      String
  speciesId                 String
  sex                       AnimalSex
  birthDate                 DateTime?
  description               String
  imageUrl                  String?
  status                    AnimalStatus @default(ACTIVE)
  isAvailableForSponsorship Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  species      Species       @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  sponsorships Sponsorship[]

  @@index([speciesId])
  @@index([status, isAvailableForSponsorship])
  @@unique([speciesId, name])
}

model Sponsorship {
  id          String               @id @default(cuid())
  type        SponsorshipType
  frequency   SponsorshipFrequency
  status      SponsorshipStatus    @default(PENDING)
  amount      Decimal              @db.Decimal(12, 2)

  userId      String
  animalId    String?

  donorName    String
  donorEmail   String
  donorAddress String

  contactConsentAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal? @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([animalId])
  @@index([status])
  @@index([createdAt])
}